[Unit]
Description=LunaSecurity ClamAV Echtzeitschutz
After=clamav-daemon.service
Requires=clamav-daemon.service
StartLimitIntervalSec=60
StartLimitBurst=1

[Service]
Type=simple
ExecStart=/usr/lib/lunasecurity/lunasecurity-realtime
Restart=no
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
