#!/bin/sh
set -u
if [ "${1:-}" != "scan" ]; then
    echo "Aufruf: clamav-scan-helper scan [clamscan-Optionen ...]" >&2
    exit 2
fi
shift
CLAMSCAN=$(command -v clamscan) || { echo "clamscan ist nicht installiert." >&2; exit 127; }
PIDFILE=/run/lunasecurity-clamav-scan.pid
setsid "$CLAMSCAN" "$@" &
child=$!
printf '%s\\n' "$child" > "$PIDFILE"
chmod 600 "$PIDFILE"
cleanup() {
    rm -f "$PIDFILE"
}
terminate_scan() {
    trap - TERM INT HUP
    kill -TERM -- "-$child" 2>/dev/null || kill -TERM "$child" 2>/dev/null || true
    i=0
    while kill -0 "$child" 2>/dev/null && [ "$i" -lt 4 ]; do
        sleep 1
        i=$((i + 1))
    done
    kill -KILL -- "-$child" 2>/dev/null || kill -KILL "$child" 2>/dev/null || true
    wait "$child" 2>/dev/null || true
    cleanup
    exit 130
}
trap terminate_scan TERM INT HUP
set +e
wait "$child"
status=$?
set -e
cleanup
exit "$status"
