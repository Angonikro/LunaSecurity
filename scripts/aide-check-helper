#!/bin/sh
# Root-Helfer: AIDE läuft in einer eigenen Session/Prozessgruppe.
# Die PID-Datei wird IN der neuen Session geschrieben; damit ist $$
# garantiert die tatsächliche Prozessgruppen-ID des gestarteten Prüflaufs.
set -u
PIDFILE=/run/lunasecurity-aide.pgid
if [ "$(id -u)" -ne 0 ]; then
    echo "Fehler: AIDE-Prüfung benötigt Root-Rechte." >&2
    exit 1
fi
if command -v aide.wrapper >/dev/null 2>&1; then
    set -- "$(command -v aide.wrapper)" --check
elif command -v aide >/dev/null 2>&1; then
    if [ -r /var/lib/aide/aide.conf.autogenerated ]; then
        set -- "$(command -v aide)" --config /var/lib/aide/aide.conf.autogenerated --check
    elif [ -r /etc/aide/aide.conf ]; then
        set -- "$(command -v aide)" --config /etc/aide/aide.conf --check
    else
        echo "AIDE-Konfiguration fehlt. Bitte update-aide.conf ausführen und die Referenzdatenbank mit aideinit vorbereiten." >&2
        exit 2
    fi
else
    echo "AIDE ist nicht installiert. Installiere das Debian-Paket aide." >&2
    exit 127
fi

cleanup() { rm -f "$PIDFILE"; }
trap cleanup EXIT HUP INT TERM
# setsid --fork garantiert eine neue Session. Das innere Shell-Skript
# schreibt seine eigene PID (gleich PGID) und ersetzt sich danach per exec.
setsid --fork --wait sh -c '
    pidfile=$1
    shift
    printf "%s\\n" "$$" > "$pidfile"
    exec "$@"
' sh "$PIDFILE" "$@" &
launcher=$!
wait "$launcher"
status=$?
cleanup
trap - EXIT HUP INT TERM
exit "$status"
